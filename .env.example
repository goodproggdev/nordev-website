# Copia questo file in .env.local e valorizza le variabili prima di avviare il progetto
# in locale (npm run dev). Su Vercel vanno impostate in Project Settings -> Environment
# Variables (NON vanno mai committate su git).

# --- SMTP per l'invio email dal form di contatto (app/api/send-email/route.ts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER=
